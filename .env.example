# ==============================================================================
# VigiMinas - Arquivo de Configuração de Variáveis de Ambiente (.env.example)
# Sistema de Gestão da Vigilância Sanitária Municipal de Braúnas/MG
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTIFICAÇÃO E AMBIENTE DA APLICAÇÃO (FastAPI Backend)
# ------------------------------------------------------------------------------
PROJECT_NAME="VigiMinas"
ENVIRONMENT="development"
DEBUG=True
API_HOST="0.0.0.0"
API_PORT=8000

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS POSTGRESQL (Container Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER="vigiminas_user"
POSTGRES_PASSWORD="vigiminas_pass"
POSTGRES_DB="vigiminas_db"
POSTGRES_PORT=5434

# ------------------------------------------------------------------------------
# 3. CONEXÃO COM O BANCO DE DADOS (Dualidade de Drivers SQLAlchemy 2.0)
# ------------------------------------------------------------------------------
# Driver Assíncrono (FastAPI Runtime - asyncpg)
DATABASE_URL="postgresql+asyncpg://vigiminas_user:vigiminas_pass@localhost:5434/vigiminas_db"

# Driver Síncrono (Alembic Migrations - psycopg2)
DATABASE_URL_SYNC="postgresql+psycopg2://vigiminas_user:vigiminas_pass@localhost:5434/vigiminas_db"

# ------------------------------------------------------------------------------
# 4. SEGURANÇA E AUTENTICAÇÃO JWT
# ------------------------------------------------------------------------------
# Em produção, gere uma chave forte com: openssl rand -hex 32
SECRET_KEY="sua_chave_secreta_super_segura_deve_ser_alterada_em_producao"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 5. CONTROLE DE CORS (Cross-Origin Resource Sharing)
# Suporta array JSON '["http://..."]' ou lista separada por vírgula 'http://...,http://...'
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 6. CLIENTE FRONTEND (Vite / React SPA)
# ------------------------------------------------------------------------------
# URL base para consumo da API FastAPI pelo ApiClient (em dev usa proxy ou porta 8000)
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# ------------------------------------------------------------------------------
# 7. PLATAFORMA E HOSPEDAGEM (Opcional / Produção)
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
