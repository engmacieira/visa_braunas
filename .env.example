# Identificação e Ambiente do Sistema
PROJECT_NAME="VigiMinas"
ENVIRONMENT="development"
DEBUG=True

# Banco de Dados - PostgreSQL
# Driver Assíncrono (FastAPI Runtime - asyncpg)
DATABASE_URL="postgresql+asyncpg://vigiminas_user:vigiminas_pass@localhost:5434/vigiminas_db"

# Driver Síncrono (Alembic Migrations - psycopg2)
DATABASE_URL_SYNC="postgresql+psycopg2://vigiminas_user:vigiminas_pass@localhost:5434/vigiminas_db"

# Segurança e Autenticação JWT
SECRET_KEY="sua_chave_secreta_super_segura_deve_ser_alterada_em_producao"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - Lista de origens permitidas (JSON Array ou strings separadas por vírgula)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
