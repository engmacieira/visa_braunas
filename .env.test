# ==============================================================================
# VigiMinas - Configurações de Ambiente de Teste Isolado (.env.test)
# ==============================================================================
ENVIRONMENT="test"
DEBUG=False
TESTING=True

# Container PostgreSQL de Testes (Porta isolada 5436)
POSTGRES_USER="vigiminas_test_user"
POSTGRES_PASSWORD="vigiminas_test_password"
POSTGRES_DB="vigiminas_test_db"
POSTGRES_PORT=5436
POSTGRES_HOST="localhost"

# Drivers SQLAlchemy 2.0 apontando para o Docker de Testes
DATABASE_URL="postgresql+asyncpg://vigiminas_test_user:vigiminas_test_password@localhost:5436/vigiminas_test_db"
DATABASE_URL_SYNC="postgresql+psycopg2://vigiminas_test_user:vigiminas_test_password@localhost:5436/vigiminas_test_db"

# Cache e Mensageria (InMemory durante os testes)
REDIS_URL=""

# Chaves de Autenticação para Testes
SECRET_KEY="test_super_secret_key_for_automated_testing_jwt_braunas_isolated"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
VITE_API_BASE_URL="http://localhost:8000/api/v1"

